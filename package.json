{
  "name": "glimpse-teleprompter",
  "version": "0.1.0",
  "description": "Teleprompter web auto-hospedado: suba roteiros em Markdown pelo PC e leia no celular ou tablet.",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "reset-password": "node src/reset-password.js",
    "test": "node --test test/*.test.js",
    "test:e2e": "docker run --rm --ipc=host -v \"$PWD\":/app -w /app mcr.microsoft.com/playwright:v1.65.0-noble npx playwright test"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "dependencies": {
    "dompurify": "^3.4.17",
    "express": "^5.3.0",
    "marked": "^18.1.3"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0"
  }
}
