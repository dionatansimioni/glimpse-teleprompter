# Senha do administrador (obrigatória)
ADMIN_PASSWORD=troque-esta-senha
# Porta exposta no host
GLIMPSE_PORT=3000
# Permitir leitura dos roteiros sem login (true/false)
PUBLIC_READ=false
# Use true quando estiver atrás de HTTPS (proxy reverso)
COOKIE_SECURE=false
# Número de proxies reversos à frente do Glimpse (ex.: 1); vazio = nenhum
TRUST_PROXY=
