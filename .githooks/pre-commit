#!/bin/sh
# Bloqueia o commit se houver segredos (tokens, chaves, senhas) nas mudanças.
# Ativação (uma vez por clone): git config core.hooksPath .githooks
set -eu
GITLEAKS_IMAGE="zricethezav/gitleaks:v8.30.1"

if command -v gitleaks >/dev/null 2>&1; then
  exec gitleaks git --pre-commit --staged --redact --no-banner .
elif command -v docker >/dev/null 2>&1; then
  exec docker run --rm -v "$(git rev-parse --show-toplevel)":/repo "$GITLEAKS_IMAGE" \
    git --pre-commit --staged --redact --no-banner /repo
else
  echo "pre-commit: gitleaks/docker não encontrados; verificação de segredos pulada." >&2
fi
